      \u0432 \u0442\u0435\u0447\u0435\u043D\u0438\u0435 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u0438\u0445
      \u043C\u0438\u043D\u0443\u0442. \u0415\u0441\u043B\u0438 \u0441\u0443\u043C\u043C\u0430
      \u0438\u043B\u0438 \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E
      \u0432\u044B\u0432\u043E\u0434\u043E\u0432 \u043F\u0440\u0435\u0432\u044B\u0448\u0430\u0435\u0442
