      \u043F\u0440\u043E\u0439\u0434\u0435\u043D\u043E, \u0442\u0435\u043C \u0431\u043E\u043B\u044C\u0448\u0435
      \u043D\u0430\u0433\u0440\u0430\u0434. \u0412\u044B\u0432\u043E\u0434 \u0434\u043E\u0441\u0442\u0443\u043F\u0435\u043D
      \u043F\u043E\u0441\u043B\u0435 \u0432\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u044F
      \u0443\u0441\u043B\u043E\u0432\u0438\u0439.</color>\"\r\n      ],\r\n     
      [\r\n        \"ja-JP\",\r\n        \"<color=#C26F50><b>\u51FA\u91D1\u65B9\u6CD5\u306F\uFF1F</b></color>\\n<color=#9E5A41>\u30B9\u30C6\u30FC\u30B8\u3092\u30AF\u30EA\u30A2\u3059\u308B\u3054\u3068\u306B\u73FE\u91D1\u5831\u916C\u304C\u7372\u5F97\u3067\u304D\u307E\u3059\u3002\u30AF\u30EA\u30A2\u6570\u304C\u591A\u3044\u307B\u3069\u5831\u916C\u3082\u5897\u3048\u307E\u3059\u3002\u51FA\u91D1\u6761\u4EF6\u3092\u6E80\u305F\u3059\u3068\u51FA\u91D1\u3067\u304D\u307E\u3059\u3002</color>\"\r\n     
      ],\r\n      [\r\n        \"ko-KR\",\r\n        \"<color=#C26F50><b>\uCD9C\uAE08\uC740
      \uC5B4\uB5BB\uAC8C \uD558\uB098\uC694?</b></color>\\n<color=#9E5A41>\uB808\uBCA8\uC744
      \uD074\uB9AC\uC5B4\uD560 \uB54C\uB9C8\uB2E4 \uD604\uAE08 \uBCF4\uC0C1\uC744
      \uBC1B\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uB354 \uB9CE\uC740 \uB808\uBCA8\uC744
      \uC644\uB8CC\uD560\uC218\uB85D \uBCF4\uC0C1\uC774 \uC99D\uAC00\uD558\uBA70,
      \uCD9C\uAE08 \uC870\uAC74\uC744 \uCDA9\uC871\uD558\uBA74 \uCD9C\uAE08\uD560
      \uC218 \uC788\uC2B5\uB2C8\uB2E4.</color>\"\r\n      ],\r\n      [\r\n       
      \"es-ES\",\r\n        \"<color=#C26F50><b>\xBFC\xF3mo puedo retirar dinero?</b></color>\\n<color=#9E5A41>Obtienes
      recompensas en efectivo por cada nivel que completas. Cuantos m\xE1s niveles
      completes, m\xE1s recompensas recibir\xE1s. Podr\xE1s retirar cuando cumplas
      los requisitos.</color>\"\r\n      ],\r\n      [\r\n        \"es-MX\",\r\n       
      \"<color=#C26F50><b>\xBFC\xF3mo puedo retirar dinero?</b></color>\\n<color=#9E5A41>Recibes
      recompensas en efectivo por cada nivel superado. Entre m\xE1s niveles completes,
      mayores ser\xE1n las recompensas. Podr\xE1s retirar al cumplir los requisitos.</color>\"\r\n     
      ],\r\n      [\r\n        \"tr-TR\",\r\n        \"<color=#C26F50><b>Nas\u0131l
      para \xE7ekebilirim?</b></color>\\n<color=#9E5A41>Tamamlad\u0131\u011F\u0131n\u0131z
      her seviye i\xE7in nakit \xF6d\xFCl kazan\u0131rs\u0131n\u0131z. Daha fazla
      seviye tamamlad\u0131k\xE7a \xF6d\xFCller artar. \xC7ekim \u015Fartlar\u0131n\u0131
      sa\u011Flad\u0131\u011F\u0131n\u0131zda para \xE7ekebilirsiniz.</color>\"\r\n     
      ],\r\n      [\r\n        \"en-PH\",\r\n        \"<color=#C26F50><b>How can
      I withdraw cash?</b></color>\\n<color=#9E5A41>You earn cash rewards for every
      level you complete. The more levels you finish, the more rewards you get. You
      can withdraw cash once you meet the withdrawal requirements.</color>\"\r\n     
      ],\r\n      [\r\n        \"vi-VN\",\r\n        \"<color=#C26F50><b>L\xE0m th\u1EBF
      n\xE0o \u0111\u1EC3 r\xFAt ti\u1EC1n?</b></color>\\n<color=#9E5A41>B\u1EA1n
      nh\u1EADn \u0111\u01B0\u1EE3c ph\u1EA7n th\u01B0\u1EDFng ti\u1EC1n m\u1EB7t
      khi ho\xE0n th\xE0nh m\u1ED7i m\xE0n ch\u01A1i. C\xE0ng ho\xE0n th\xE0nh nhi\u1EC1u
      m\xE0n, ph\u1EA7n th\u01B0\u1EDFng c\xE0ng l\u1EDBn. B\u1EA1n c\xF3 th\u1EC3
      r\xFAt ti\u1EC1n khi \u0111\xE1p \u1EE9ng \u0111i\u1EC1u ki\u1EC7n.</color>\"\r\n     
      ]\r\n    ]\r\n  },\r\n  {\r\n    \"Id\": \"FAQPanel_Question2\",\r\n    \"dict\":
      [\r\n      [\r\n        \"zh-CN\",\r\n        \"<color=#C26F50><b>\u63D0\u73B0\u9700\u8981\u591A\u957F\u65F6\u95F4\uFF1F</b></color>\\n<color=#9E5A41>\u901A\u5E38\u60C5\u51B5\u4E0B\uFF0C\u8D44\u91D1\u4F1A\u5728\u51E0\u5206\u949F\u5185\u5230\u8D26\u3002\u5982\u679C\u63D0\u73B0\u6B21\u6570\u6216\u63D0\u73B0\u91D1\u989D\u8D85\u8FC7\u4E00\u5B9A\u9650\u989D\uFF0C\u7CFB\u7EDF\u4F1A\u8FDB\u884C\u5BA1\u6838\u3002\u8FD9\u79CD\u60C5\u51B5\u4E0B\uFF0C\u8D44\u91D1\u4ECD\u4F1A\u5728 
      <color=#D98A6B><b>24 hours</b></color>\u5C0F\u65F6\u5185\u5230\u8D26\uFF0C\u8BF7\u60A8\u653E\u5FC3\u3002</color>\"\r\n     
      ],\r\n      [\r\n        \"en-US\",\r\n        \"<color=#C26F50><b>How long
      does it take to withdraw money?</b></color>\\n<color=#9E5A41>Generally, funds
      will be credited to your account within a few minutes. If the number of withdrawals
      or the withdrawal amount exceeds a certain limit, the system will review it.
      In this case, the funds will still be credited within <color=#D98A6B><b>24
      hours</b></color>, so please don\u2019t worry.</color>\"\r\n      ],\r\n     
      [\r\n        \"pt-BR\",\r\n        \"<color=#C26F50><b>Quanto tempo leva para
      sacar dinheiro?</b></color>\\n<color=#9E5A41>Normalmente, os fundos s\xE3o
      creditados na sua conta em poucos minutos. Se o n\xFAmero de saques ou o valor
      exceder um determinado limite, o sistema far\xE1 uma an\xE1lise. Nesse caso,
      os fundos ser\xE3o creditados em at\xE9 <color=#D98A6B><b>24 horas</b></color>,
      ent\xE3o n\xE3o se preocupe.</color>\"\r\n      ],\r\n      [\r\n        \"id-ID\",\r\n       
      \"<color=#C26F50><b>Berapa lama waktu penarikan?</b></color>\\n<color=#9E5A41>Biasanya
      dana akan masuk ke akun Anda dalam beberapa menit. Jika jumlah atau nominal
      penarikan melebihi batas tertentu, sistem akan melakukan peninjauan. Dalam
      kasus ini, dana tetap akan masuk dalam waktu <color=#D98A6B><b>24 jam</b></color>,
      jadi jangan khawatir.</color>\"\r\n      ],\r\n      [\r\n        \"ru-RU\",\r\n       
      \"<color=#C26F50><b>\u0421\u043A\u043E\u043B\u044C\u043A\u043E \u0432\u0440\u0435\u043C\u0435\u043D\u0438
      \u0437\u0430\u043D\u0438\u043C\u0430\u0435\u0442 \u0432\u044B\u0432\u043E\u0434
      \u0441\u0440\u0435\u0434\u0441\u0442\u0432?</b></color>\\n<color=#9E5A41>\u041E\u0431\u044B\u0447\u043D\u043E
      \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430 \u0437\u0430\u0447\u0438\u0441\u043B\u044F\u044E\u0442\u0441\u044F
      \u043D\u0430 \u0432\u0430\u0448 \u0430\u043A\u043A\u0430\u0443\u043D\u0442
      \u0432 \u0442\u0435\u0447\u0435\u043D\u0438\u0435 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u0438\u0445
      \u043C\u0438\u043D\u0443\u0442. \u0415\u0441\u043B\u0438 \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E
      \u0432\u044B\u0432\u043E\u0434\u043E\u0432 \u0438\u043B\u0438 \u0441\u0443\u043C\u043C\u0430
      \u043F\u0440\u0435\u0432\u044B\u0448\u0430\u0435\u0442 \u043B\u0438\u043C\u0438\u0442,
      \u0441\u0438\u0441\u0442\u0435\u043C\u0430 \u043F\u0440\u043E\u0432\u0435\u0434\u0451\u0442
      \u043F\u0440\u043E\u0432\u0435\u0440\u043A\u0443. \u0412 \u044D\u0442\u043E\u043C
      \u0441\u043B\u0443\u0447\u0430\u0435 \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430
      \u0431\u0443\u0434\u0443\u0442 \u0437\u0430\u0447\u0438\u0441\u043B\u0435\u043D\u044B
      \u0432 \u0442\u0435\u0447\u0435\u043D\u0438\u0435 <color=#D98A6B><b>24 \u0447\u0430\u0441\u043E\u0432</b></color>,
      \u043D\u0435 \u0431\u0435\u0441\u043F\u043E\u043A\u043E\u0439\u0442\u0435\u0441\u044C.</color>\"\r\n     
      ],\r\n      [\r\n        \"ja-JP\",\r\n        \"<color=#C26F50><b>\u51FA\u91D1\u306B\u306F\u3069\u308C\u304F\u3089\u3044\u6642\u9593\u304C\u304B\u304B\u308A\u307E\u3059\u304B\uFF1F</b></color>\\n<color=#9E5A41>\u901A\u5E38\u3001\u6570\u5206\u4EE5\u5185\u306B\u30A2\u30AB\u30A6\u30F3\u30C8\u3078\u53CD\u6620\u3055\u308C\u307E\u3059\u3002\u51FA\u91D1\u56DE\u6570\u3084\u91D1\u984D\u304C\u4E00\u5B9A\u306E\u4E0A\u9650\u3092\u8D85\u3048\u305F\u5834\u5408\u3001\u30B7\u30B9\u30C6\u30E0\u306B\u3088\u308B\u5BE9\u67FB\u304C\u884C\u308F\u308C\u307E\u3059\u3002\u305D\u306E\u5834\u5408\u3067\u3082\u3001<color=#D98A6B><b>24\u6642\u9593</b></color>\u4EE5\u5185\u306B\u53CD\u6620\u3055\u308C\u307E\u3059\u306E\u3067\u3054\u5B89\u5FC3\u304F\u3060\u3055\u3044\u3002</color>\"\r\n     
      ],\r\n      [\r\n        \"ko-KR\",\r\n        \"<color=#C26F50><b>\uCD9C\uAE08\uC5D0\uB294
      \uC5BC\uB9C8\uB098 \uC2DC\uAC04\uC774 \uAC78\uB9AC\uB098\uC694?</b></color>\\n<color=#9E5A41>\uC77C\uBC18\uC801\uC73C\uB85C
      \uBA87 \uBD84 \uB0B4\uC5D0 \uACC4\uC815\uC73C\uB85C \uC785\uAE08\uB429\uB2C8\uB2E4.
      \uCD9C\uAE08 \uD69F\uC218\uB098 \uAE08\uC561\uC774 \uC77C\uC815 \uD55C\uB3C4\uB97C
      \uCD08\uACFC\uD558\uBA74 \uC2DC\uC2A4\uD15C \uAC80\uD1A0\uAC00 \uC9C4\uD589\uB429\uB2C8\uB2E4.
      \uC774 \uACBD\uC6B0\uC5D0\uB3C4 <color=#D98A6B><b>24\uC2DC\uAC04</b></color>
      \uC774\uB0B4\uC5D0 \uC785\uAE08\uB418\uB2C8 \uAC71\uC815\uD558\uC9C0 \uB9C8\uC138\uC694.</color>\"\r\n     
      ],\r\n      [\r\n        \"es-ES\",\r\n        \"<color=#C26F50><b>\xBFCu\xE1nto
      tiempo tarda el retiro?</b></color>\\n<color=#9E5A41>Por lo general, los fondos
      se acreditan en su cuenta en unos minutos. Si la cantidad de retiros o el monto
      supera un l\xEDmite, el sistema realizar\xE1 una revisi\xF3n. En ese caso,
      los fondos se acreditar\xE1n en un plazo de <color=#D98A6B><b>24 horas</b></color>,
      as\xED que no se preocupe.</color>\"\r\n      ],\r\n      [\r\n        \"es-MX\",\r\n       
      \"<color=#C26F50><b>\xBFCu\xE1nto tiempo tarda el retiro?</b></color>\\n<color=#9E5A41>Normalmente,
      el dinero se acredita en tu cuenta en pocos minutos. Si el n\xFAmero de retiros
      o el monto supera un l\xEDmite, el sistema har\xE1 una revisi\xF3n. En ese
      caso, el dinero llegar\xE1 dentro de <color=#D98A6B><b>24 horas</b></color>,
      as\xED que no te preocupes.</color>\"\r\n      ],\r\n      [\r\n        \"tr-TR\",\r\n       
      \"<color=#C26F50><b>Para \xE7ekme ne kadar s\xFCrer?</b></color>\\n<color=#9E5A41>Genellikle
      para birka\xE7 dakika i\xE7inde hesab\u0131n\u0131za yat\u0131r\u0131l\u0131r.
      \xC7ekim say\u0131s\u0131 veya tutar\u0131 belirli bir limiti a\u015Farsa sistem
      inceleme yapar. Bu durumda para <color=#D98A6B><b>24 saat</b></color> i\xE7inde
      yat\u0131r\u0131l\u0131r, endi\u015Felenmeyin.</color>\"\r\n      ],\r\n     
      [\r\n        \"en-PH\",\r\n        \"<color=#C26F50><b>How long does it take
      to withdraw money?</b></color>\\n<color=#9E5A41>Funds are usually credited
      to your account within a few minutes. If the withdrawal count or amount exceeds
      a set limit, the system will review it. Even then, funds will be credited within
      <color=#D98A6B><b>24 hours</b></color>, so there\u2019s no need to worry.</color>\"\r\n     
      ],\r\n      [\r\n        \"vi-VN\",\r\n        \"<color=#C26F50><b>R\xFAt ti\u1EC1n
      m\u1EA5t bao l\xE2u?</b></color>\\n<color=#9E5A41>Th\xF4ng th\u01B0\u1EDDng
      ti\u1EC1n s\u1EBD \u0111\u01B0\u1EE3c chuy\u1EC3n v\xE0o t\xE0i kho\u1EA3n
      trong v\xE0i ph\xFAt. N\u1EBFu s\u1ED1 l\u1EA7n r\xFAt ho\u1EB7c s\u1ED1 ti\u1EC1n
      v\u01B0\u1EE3t qu\xE1 gi\u1EDBi h\u1EA1n, h\u1EC7 th\u1ED1ng s\u1EBD x\xE9t
      duy\u1EC7t. Trong tr\u01B0\u1EDDng h\u1EE3p \u0111\xF3, ti\u1EC1n v\u1EABn
      s\u1EBD \u0111\u01B0\u1EE3c chuy\u1EC3n trong v\xF2ng <color=#D98A6B><b>24
      gi\u1EDD</b></color>, v\xEC v\u1EADy b\u1EA1n kh\xF4ng c\u1EA7n lo l\u1EAFng.</color>\"\r\n     
      ]\r\n    ]\r\n  },\r\n  {\r\n    \"Id\": \"FAQPanel_Question3\",\r\n    \"dict\":
      [\r\n      [\r\n        \"zh-CN\",\r\n        \"<color=#C26F50><b>\u4E3A\u4EC0\u4E48\u6211\u63D0\u73B0\u5931\u8D25\u4E86?</b></color>\\n<color=#9E5A41>\u5982\u679C\u53D6\u6B3E\u64CD\u4F5C\u5931\u8D25\uFF0C\u7CFB\u7EDF\u4F1A\u7528\u82F1\u6587\u7ED9\u51FA\u539F\u56E0\u3002\u8BF7\u6839\u636E\u63D0\u793A\u4FEE\u6539\u60A8\u7684\u4FE1\u606F\u3002\u5982\u679C\u53D6\u6B3E\u5931\u8D25\uFF0C\u53D6\u6B3E\u91D1\u989D\u5C06\u81EA\u52A8\u9000\u56DE\u3002\u60A8\u53EF\u4EE5\u66F4\u65B0\u4FE1\u606F\u5E76\u518D\u6B21\u53D1\u8D77\u53D6\u6B3E\u64CD\u4F5C\u3002\u8BF7\u786E\u4FDD\u60A8\u63D0\u4F9B\u7684\u6240\u6709\u4FE1\u606F\u90FD\u662F\u6B63\u786E\u7684\u3002\u6211\u4EEC<color=#B64A3A><b>\u4E0D\u8D1F\u8D23</b></color>
      \u56E0\u9519\u8BEF\u4FE1\u606F\u5BFC\u81F4\u7684\u53D6\u6B3E\u5931\u8D25\u3002</color>\"\r\n     
      ],\r\n      [\r\n        \"en-US\",\r\n        \"<color=#C26F50><b>Why did
      my withdrawal fail?</b></color>\\n<color=#9E5A41>If a withdrawal fails, the
      system will provide the reason in English. Please modify your information according
      to the prompt. If the withdrawal fails, the withdrawal amount will be returned
      automatically. You can update your information and initiate the withdrawal
      again. Please make sure all the information you provide is correct. We are
      <color=#B64A3A><b>not responsible</b></color> for withdrawal failures caused
      by incorrect information.</color>\"\r\n      ],\r\n      [\r\n        \"pt-BR\",\r\n       
      \"<color=#C26F50><b>Por que meu saque falhou?</b></color>\\n<color=#9E5A41>Se
      o saque falhar, o sistema exibir\xE1 o motivo em ingl\xEAs. Ajuste suas informa\xE7\xF5es
      conforme a orienta\xE7\xE3o. O valor ser\xE1 devolvido automaticamente. Voc\xEA
      pode atualizar seus dados e tentar novamente. Certifique-se de que todas as
      informa\xE7\xF5es fornecidas estejam corretas. N\xE3o somos <color=#B64A3A><b>respons\xE1veis</b></color>
      por falhas causadas por informa\xE7\xF5es incorretas.</color>\"\r\n      ],\r\n     
      [\r\n        \"id-ID\",\r\n        \"<color=#C26F50><b>Mengapa penarikan saya
      gagal?</b></color>\\n<color=#9E5A41>Jika penarikan gagal, sistem akan menampilkan
      alasannya dalam bahasa Inggris. Silakan perbarui informasi sesuai petunjuk.
      Dana akan dikembalikan secara otomatis. Anda dapat memperbarui data dan mengajukan
      penarikan kembali. Pastikan semua informasi yang Anda berikan benar. Kami <color=#B64A3A><b>tidak
      bertanggung jawab</b></color> atas kegagalan akibat informasi yang salah.</color>\"\r\n     
      ],\r\n      [\r\n        \"ru-RU\",\r\n        \"<color=#C26F50><b>\u041F\u043E\u0447\u0435\u043C\u0443
      \u0432\u044B\u0432\u043E\u0434 \u0441\u0440\u0435\u0434\u0441\u0442\u0432 \u043D\u0435
      \u0443\u0434\u0430\u043B\u0441\u044F?</b></color>\\n<color=#9E5A41>\u0415\u0441\u043B\u0438
      \u0432\u044B\u0432\u043E\u0434 \u043D\u0435 \u0443\u0434\u0430\u043B\u0441\u044F,
      \u0441\u0438\u0441\u0442\u0435\u043C\u0430 \u0443\u043A\u0430\u0436\u0435\u0442
      \u043F\u0440\u0438\u0447\u0438\u043D\u0443 \u043D\u0430 \u0430\u043D\u0433\u043B\u0438\u0439\u0441\u043A\u043E\u043C
      \u044F\u0437\u044B\u043A\u0435. \u0418\u0441\u043F\u0440\u0430\u0432\u044C\u0442\u0435
      \u0434\u0430\u043D\u043D\u044B\u0435 \u0441\u043E\u0433\u043B\u0430\u0441\u043D\u043E
      \u043F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0435. \u0421\u0443\u043C\u043C\u0430
      \u0431\u0443\u0434\u0435\u0442 \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438
