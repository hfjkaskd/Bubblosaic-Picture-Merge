      \"dict\": [\r\n      [\r\n        \"zh-CN\",\r\n        \"<color=#C26F50><b>\u6211\u5982\u4F55\u63D0\u73B0\u5417\uFF1F</b></color>\\n<color=#9E5A41>\u6BCF\u901A\u8FC7\u4E00\u4E2A\u5173\u5361\u90FD\u4F1A\u83B7\u5F97\u73B0\u91D1\u5956\u52B1\u3002\u901A\u8FC7\u7684\u5173\u5361\u8D8A\u591A\uFF0C\u83B7\u5F97\u7684\u5956\u52B1\u5C31\u8D8A\u591A\u3002\u5F53\u60A8\u6EE1\u8DB3\u63D0\u73B0\u6761\u4EF6\u540E\uFF0C\u5373\u53EF\u8FDB\u884C\u63D0\u73B0\u3002</color>\\n\\n<color=#C26F50><b>\u63D0\u73B0\u9700\u8981\u591A\u957F\u65F6\u95F4\u5230\u8D26\uFF1F</b></color>\\n<color=#9E5A41>\u4E00\u822C\u60C5\u51B5\u4E0B\uFF0C\u8D44\u91D1\u4F1A\u5728\u51E0\u5206\u949F\u5185\u5230\u8D26\u3002\u5982\u679C\u63D0\u73B0\u6B21\u6570\u6216\u63D0\u73B0\u91D1\u989D\u8D85\u8FC7\u4E00\u5B9A\u9650\u5236\uFF0C\u7CFB\u7EDF\u5C06\u8FDB\u884C\u5BA1\u6838\u3002\u5728\u8FD9\u79CD\u60C5\u51B5\u4E0B\uFF0C\u8D44\u91D1\u4ECD\u4F1A\u5728
      <color=#D98A6B><b>24 \u5C0F\u65F6</b></color> \u5185\u5230\u8D26\uFF0C\u8BF7\u60A8\u653E\u5FC3\u3002</color>\\n\\n<color=#C26F50><b>\u4E3A\u4EC0\u4E48\u6211\u7684\u63D0\u73B0\u5931\u8D25\u4E86\uFF1F</b></color>\\n<color=#9E5A41>\u5982\u679C\u63D0\u73B0\u5931\u8D25\uFF0C\u7CFB\u7EDF\u4F1A\u4EE5\u82F1\u6587\u63D0\u793A\u5931\u8D25\u539F\u56E0\u3002\u8BF7\u6839\u636E\u63D0\u793A\u4FEE\u6539\u60A8\u7684\u4FE1\u606F\u3002\u82E5\u63D0\u73B0\u5931\u8D25\uFF0C\u63D0\u73B0\u91D1\u989D\u5C06\u81EA\u52A8\u9000\u56DE\u3002\u60A8\u53EF\u4EE5\u66F4\u65B0\u4FE1\u606F\u540E\u518D\u6B21\u53D1\u8D77\u63D0\u73B0\u3002\u8BF7\u52A1\u5FC5\u786E\u4FDD\u60A8\u63D0\u4F9B\u7684\u6240\u6709\u4FE1\u606F\u5747\u51C6\u786E\u65E0\u8BEF\u3002\u56E0\u4FE1\u606F\u586B\u5199\u9519\u8BEF\u5BFC\u81F4\u7684\u63D0\u73B0\u5931\u8D25\uFF0C\u6211\u4EEC
      <color=#B64A3A><b>\u6982\u4E0D\u8D1F\u8D23</b></color>\u3002</color>\\n\\n<color=#C26F50><b>\u6211\u53EF\u4EE5\u63D0\u73B0\u591A\u5C11\u6B21\uFF1F</b></color>\\n<color=#9E5A41>\u4E0D\u9650\u6B21\u6570\u3002</color>\\n\\n<color=#C26F50><b>\u6BCF\u5929\u53EF\u4EE5\u63D0\u73B0\u591A\u5C11\u6B21\uFF1F</b></color>\\n<color=#9E5A41>\u6BCF\u5929\u6700\u591A\u53EF\u63D0\u73B0
      <color=#D98A6B><b>5</b></color> \u6B21\u3002</color>\\n\\n<color=#C26F50><b>\u4E3A\u4EC0\u4E48\u6211\u65E0\u6CD5\u4F7F\u7528\u6211\u7684\u63D0\u73B0\u8D26\u6237\u8FDB\u884C\u63D0\u73B0\uFF1F</b></color>\\n<color=#9E5A41>\u540C\u4E00\u4E2A\u63D0\u73B0\u8D26\u6237\u6700\u591A\u53EA\u80FD\u7ED1\u5B9A
