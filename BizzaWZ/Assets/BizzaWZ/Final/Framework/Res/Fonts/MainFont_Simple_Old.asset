      \u043A\u0430\u0436\u0434\u044B\u0439 \u043F\u0440\u043E\u0439\u0434\u0435\u043D\u043D\u044B\u0439
      \u0443\u0440\u043E\u0432\u0435\u043D\u044C \u043D\u0430\u0447\u0438\u0441\u043B\u044F\u044E\u0442\u0441\u044F
      \u0434\u0435\u043D\u0435\u0436\u043D\u044B\u0435 \u043D\u0430\u0433\u0440\u0430\u0434\u044B.
      \u0427\u0435\u043C \u0431\u043E\u043B\u044C\u0448\u0435 \u0443\u0440\u043E\u0432\u043D\u0435\u0439
